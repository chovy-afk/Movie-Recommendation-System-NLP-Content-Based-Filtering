# Your own API's access key — the frontend must send this exact value
# in the X-API-Key header. Change it to something random.
APP_API_KEY=changeme-dev-key

# Free key from https://www.themoviedb.org/settings/api (sign up, no cost)
TMDB_API_KEY=

# ISO 3166-1 country code for watch-provider results (IN = India)
WATCH_REGION=IN
